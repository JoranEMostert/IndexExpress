LLM_API_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=
LLM_MODEL_ID=your-model-id
# Legacy alias still accepted when LLM_MODEL_ID is empty.
LLM_MODEL=
LLM_TIMEOUT=0
LLM_MAX_PARALLEL=4

SEARXNG_URL=http://searxng:8080
SEARXNG_TIMEOUT=0

PEEK_MAX_URLS=5
SKIM_MAX_URLS=15
SKIM_AGENT_COUNT=1
ANALYZE_SOURCES_PER_AGENT=12
ANALYZE_AGENT_COUNT=2
ANALYZE_CONTRADICTION_AGENTS=0
# Optional: leave empty to inherit MAX_CONCURRENT_AGENTS.
RESEARCH_MAX_SUB_QUERIES=
RESEARCH_SOURCES_PER_SUB_QUERY=8
MAX_CONCURRENT_AGENTS=7

LOG_LEVEL=INFO
