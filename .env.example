# -----------------------------------------------------------------------------
# Minimal config (recommended)
# -----------------------------------------------------------------------------
# For most setups, only set these 4 values.
LLM_API_URL=http://localhost:1234/v1
LLM_API_KEY=
LLM_MODEL_ID=your-model-id
LLM_MAX_PARALLEL=4

# Podman/host-network default for this repo setup.
SEARXNG_URL=http://localhost:8888

# -----------------------------------------------------------------------------
# Optional tuning (leave defaults unless you are benchmarking or load-tuning)
# -----------------------------------------------------------------------------
LLM_TIMEOUT=0
LLM_RETRIES=2

SEARXNG_TIMEOUT=0
SEARXNG_RETRIES=2

PEEK_MAX_URLS=5
SKIM_MAX_URLS=15
SKIM_AGENT_COUNT=1
ANALYZE_SOURCES_PER_AGENT=12
ANALYZE_AGENT_COUNT=2
ANALYZE_CONTRADICTION_AGENTS=0
RESEARCH_MAX_SUB_QUERIES=
RESEARCH_SOURCES_PER_SUB_QUERY=8
MAX_CONCURRENT_AGENTS=7
QUERY_MAX_LENGTH=600

READINESS_REQUIRE_LLM=true
TOOL_TIMEOUT_PEEK=30
TOOL_TIMEOUT_SKIM=120
TOOL_TIMEOUT_ANALYZE=300
TOOL_TIMEOUT_RESEARCH=900
HTTP_RETRY_BASE_MS=250

LOG_LEVEL=INFO
LOG_FORMAT=text
